# ------------------------------------------------------------------
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3333
TZ=America/Sao_Paulo

# --- Banco (Railway fornece essa URL pronta) ---
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ct_saude_total?schema=public

# --- EVO / ABC Evo (CT-010) ---
# Token gerado em: Configuracoes > Integracoes > aba Tokens
EVO_BASE_URL=https://evo-integracao.w12app.com.br
EVO_TOKEN=
EVO_WEBHOOK_SECRET=

# --- WhatsApp ---
# oficial = Cloud API da Meta (producao) | evolution = API nao oficial (so dev)
WHATSAPP_DRIVER=oficial
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=troque-isto
WHATSAPP_APP_SECRET=
# usado so quando WHATSAPP_DRIVER=evolution
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- IA (decidido: Sonnet 5 conversa, Haiku 4.5 extrai) ---
ANTHROPIC_API_KEY=
IA_MODELO_CONVERSA=claude-sonnet-5
IA_MODELO_EXTRACAO=claude-haiku-4-5

# --- Disparo ---
DISPARO_JANELA_INICIO=08:00
DISPARO_JANELA_FIM=20:00
DISPARO_MSG_POR_MINUTO=30

# --- Painel ---
AUTH_SECRET=troque-isto-por-algo-longo-e-aleatorio
NEXT_PUBLIC_API_URL=http://localhost:3333

# --- Observabilidade (opcional) ---
SENTRY_DSN=
LOG_LEVEL=info
